
# Environment and secrets
.env
.env.*
!.env.example

# Raw datasets - never upload
*.csv
data/raw/

# Allow processed Parquet datasets
!data/
!data/processed/
!data/processed/*.parquet

# Allow required audit JSON files
artifacts/*
!artifacts/audit/
artifacts/audit/*
!artifacts/audit/*.json

# Python cache
*.pyc
__pycache__/
.pytest_cache/
.venv/
venv/

# Frontend dependencies and builds
node_modules/
.next/
dist/
build/

# Database and logs
*.duckdb
*.db
*.log
.DS_Store

# Competition documents
*.pdf
